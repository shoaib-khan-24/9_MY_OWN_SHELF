<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f8f7f4">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Shelf Notes' %></title>
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="Shelf Notes home">MyOwn<span>Shelf</span></a>
        <nav aria-label="Main navigation">
            <% if (userId) { %>
                <span>Hi, <%= userName %></span>
                <a href="/">Library</a>
                <a class="button button-small" href="/new-book">
                    Add a book <span aria-hidden="true">+</span>
                </a>

                <form action="/logout" method="post">
                    <button class="note-action" type="submit">Log out</button>
                </form>
            <% } else { %>
                <a href="/login">Log in</a>
                <a class="button button-small" href="/signup">Sign up</a>
            <% } %>
        </nav>
    </header>
